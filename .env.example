# Preencha localmente apenas o provedor que decidir usar.
# O CLI carrega este arquivo somente com --env-file .env.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Identificadores reais escolhidos pelo usuário, sem modelo presumido.
AL_IADO_OPENAI_MODEL_LUNA=
AL_IADO_OPENAI_MODEL_TERRA=
AL_IADO_OPENAI_MODEL_SOL=
AL_IADO_GEMINI_MODEL_FLASH_LITE=
AL_IADO_GEMINI_MODEL_FLASH=

# Opcional: executável do Tesseract fora do PATH e de data/tools/tesseract.
# AL_IADO_TESSERACT_CMD=
