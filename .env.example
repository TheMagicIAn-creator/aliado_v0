# Preencha localmente a chave do Gemini.
# O CLI carrega este arquivo somente com --env-file .env.
GOOGLE_API_KEY=

# Identificadores reais escolhidos pelo usuário, sem modelo presumido.
AL_IADO_GEMINI_MODEL_FLASH_LITE=
AL_IADO_GEMINI_MODEL_FLASH=

# Opcional (lote 38): modelo local no Ollama, que passa a responder primeiro; o Gemini Flash só entra quando ele
# não dá conta ou o pedido não cabe nele. Com o Ollama fechado, o erro é claro e nada vai ao Gemini.
# AL_IADO_LOCAL_MODEL=aliado-local
# AL_IADO_LOCAL_BASE_URL=http://localhost:11434/v1
# O mesmo num_ctx do Modelfile (padrão 16384): o pedido maior vai direto ao Gemini. Lote 40: neste computador,
# 32768, com 20 camadas na placa (a placa fica abaixo de 4 GB).
# AL_IADO_LOCAL_CONTEXT=32768

# Opcional (lote 63): só o modelo local responde, até você tirar esta linha e reiniciar. Sem rede, o modo entra e
# sai sozinho (lote 68), sem precisar dela.
# AL_IADO_OFFLINE=1

# Opcional (lote 29): o modelo do Gemini que descreve as figuras (flash_lite ou flash). Padrão: flash, o do piloto.
# AL_IADO_FIGURE_MODEL=flash

# Opcional: pasta do modelo de busca local (embeddings). Padrão: data/models/minilm.
# AL_IADO_EMBEDDINGS_DIR=

# Opcional: executável do Tesseract fora do PATH e de data/tools/tesseract.
# AL_IADO_TESSERACT_CMD=

# Opcional: pasta da segunda rede local, preparada com biblioteca preparar-reordenador.
# Padrão: data/models/reranker. Não há download automático durante as perguntas.
# AL_IADO_RERANKER_DIR=
